# Copy to .env (that file is gitignored). Docker Compose reads .env on its own.
#
# Compose sets HONEYJAR_ENV to production unless you override it.
# Production mode will not start unless BETTER_AUTH_SECRET is a real secret:
# set, at least 32 bytes, and not honeyjar-dev-secret-change-me.
#
# Generate one and paste it below. Keep this value. Sessions and receipt
# files are tied to it. An empty value is not a secret; Compose refuses it.
#
#   openssl rand -base64 32
#
BETTER_AUTH_SECRET=

# Optional. The public origin users type, with no path.
# BETTER_AUTH_URL=http://localhost:8080

# Optional. production is the Compose default.
# HONEYJAR_ENV=production
